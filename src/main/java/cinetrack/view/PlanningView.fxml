<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" styleClass="page" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cinetrack.controller.PlanningController">
    <padding>
        <Insets bottom="28" left="36" right="36" top="28" />
    </padding>
    <stylesheets>
        <URL value="@/css/style.css" />
    </stylesheets>
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox>
            <Label styleClass="title" text="Programmation" />
            <Label fx:id="lblNbSeances" styleClass="muted" text="0 séance" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
    </HBox>
    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <VBox spacing="12" styleClass="card" HBox.hgrow="ALWAYS">
            <HBox alignment="BOTTOM_LEFT" spacing="10">
                <VBox spacing="4">
                    <Label styleClass="field-label" text="Date" />
                    <DatePicker fx:id="dpFiltreDate" maxWidth="Infinity" onAction="#handleFiltrer" />
                </VBox>
                <VBox spacing="4">
                    <Label styleClass="field-label" text="Salle" />
                    <ComboBox fx:id="cmbFiltreSalle" maxWidth="Infinity" onAction="#handleFiltrer" promptText="Toutes" />
                </VBox>
                <VBox spacing="4">
                    <Label styleClass="field-label" text="Film" />
                    <ComboBox fx:id="cmbFiltreFilm" maxWidth="Infinity" onAction="#handleFiltrer" promptText="Tous" />
                </VBox>
            </HBox>
            <TableView fx:id="tblSeances" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colDate" prefWidth="90" text="Date" />
                    <TableColumn fx:id="colDebut" prefWidth="70" text="Début" />
                    <TableColumn fx:id="colFin" prefWidth="70" text="Fin" />
                    <TableColumn fx:id="colFilm" prefWidth="170" text="Film" />
                    <TableColumn fx:id="colSalle" prefWidth="90" text="Salle" />
                    <TableColumn fx:id="colPlaces" prefWidth="110" text="Places restantes" />
                    <TableColumn fx:id="colStatut" prefWidth="80" text="Statut" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Button fx:id="btnArchiver" onAction="#handleArchiver" styleClass="btn-archive" text="Archiver / Restaurer" />
            </HBox>
        </VBox>
        <VBox minWidth="320" prefWidth="320" spacing="12" styleClass="card">
            <Label styleClass="section-title" text="Programmer une séance" />
            <VBox spacing="4">
                <Label styleClass="field-label" text="Film" />
                <ComboBox fx:id="cmbFilm" maxWidth="Infinity" promptText="Choisir un film" />
            </VBox>
            <VBox spacing="4">
                <Label styleClass="field-label" text="Salle" />
                <ComboBox fx:id="cmbSalle" maxWidth="Infinity" promptText="Choisir une salle" />
            </VBox>
            <VBox spacing="4">
                <Label styleClass="field-label" text="Date" />
                <DatePicker fx:id="dpDate" maxWidth="Infinity" />
            </VBox>
            <VBox spacing="4">
                <Label styleClass="field-label" text="Heure de début (HH:mm)" />
                <TextField fx:id="txtHeure" promptText="20:00" />
            </VBox>
            <Label fx:id="lblConflit" styleClass="error-label" text="" wrapText="true" />
            <Button fx:id="btnProgrammer" onAction="#handleProgrammer" styleClass="btn-primary" text="Programmer" />
        </VBox>
    </HBox>
</VBox>
