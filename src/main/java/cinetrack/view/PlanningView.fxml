<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" spacing="16" styleClass="page" fx:controller="cinetrack.controller.PlanningController">
    <padding>
        <Insets top="28" right="36" bottom="28" left="36"/>
    </padding>
    <stylesheets>
        <URL value="@/css/style.css"/>
    </stylesheets>
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox>
            <Label text="Programmation" styleClass="title"/>
            <Label fx:id="lblNbSeances" text="0 séance" styleClass="muted"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>
    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <VBox spacing="12" styleClass="card" HBox.hgrow="ALWAYS">
            <HBox spacing="10" alignment="BOTTOM_LEFT">
                <VBox spacing="4">
                    <Label text="Date" styleClass="field-label"/>
                    <DatePicker fx:id="dpFiltreDate" maxWidth="Infinity" onAction="#handleFiltrer"/>
                </VBox>
                <VBox spacing="4">
                    <Label text="Salle" styleClass="field-label"/>
                    <ComboBox fx:id="cmbFiltreSalle" promptText="Toutes" maxWidth="Infinity" onAction="#handleFiltrer"/>
                </VBox>
                <VBox spacing="4">
                    <Label text="Film" styleClass="field-label"/>
                    <ComboBox fx:id="cmbFiltreFilm" promptText="Tous" maxWidth="Infinity" onAction="#handleFiltrer"/>
                </VBox>
                <CheckBox fx:id="chkArchives" text="Afficher les archivées" onAction="#handleFiltrer"/>
            </HBox>
            <TableView fx:id="tblSeances" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colDate" prefWidth="90" text="Date"/>
                    <TableColumn fx:id="colDebut" prefWidth="70" text="Début"/>
                    <TableColumn fx:id="colFin" prefWidth="70" text="Fin"/>
                    <TableColumn fx:id="colFilm" prefWidth="170" text="Film"/>
                    <TableColumn fx:id="colSalle" prefWidth="90" text="Salle"/>
                    <TableColumn fx:id="colPlaces" prefWidth="110" text="Places restantes"/>
                    <TableColumn fx:id="colStatut" prefWidth="80" text="Statut"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Button fx:id="btnArchiver" text="Archiver / Restaurer" styleClass="btn-archive" onAction="#handleArchiver"/>
            </HBox>
        </VBox>
        <VBox spacing="12" styleClass="card" prefWidth="320" minWidth="320">
            <Label text="Programmer une séance" styleClass="section-title"/>
            <VBox spacing="4">
                <Label text="Film" styleClass="field-label"/>
                <ComboBox fx:id="cmbFilm" promptText="Choisir un film" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Salle" styleClass="field-label"/>
                <ComboBox fx:id="cmbSalle" promptText="Choisir une salle" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Date" styleClass="field-label"/>
                <DatePicker fx:id="dpDate" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Heure de début (HH:mm)" styleClass="field-label"/>
                <TextField fx:id="txtHeure" promptText="20:00"/>
            </VBox>
            <Label fx:id="lblConflit" text="" styleClass="error-label" wrapText="true"/>
            <Button fx:id="btnProgrammer" text="Programmer" styleClass="btn-primary" onAction="#handleProgrammer"/>
        </VBox>
    </HBox>
</VBox>
