<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" spacing="16" styleClass="page" fx:controller="com.cinetrack.controller.SalleController">
    <padding>
        <Insets top="28" right="36" bottom="28" left="36"/>
    </padding>
    <stylesheets>
        <URL value="@../css/cinetrack.css"/>
    </stylesheets>
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox>
            <Label text="Salles et tarifs" styleClass="title"/>
            <Label fx:id="lblNbSalles" text="0 salle" styleClass="muted"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>
    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <VBox spacing="12" styleClass="card" HBox.hgrow="ALWAYS">
            <Label text="Salles de projection" styleClass="section-title"/>
            <CheckBox fx:id="chkArchives" text="Afficher les archivées" onAction="#handleFiltrer"/>
            <TableView fx:id="tblSalles" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colNom" prefWidth="160" text="Salle"/>
                    <TableColumn fx:id="colCapacite" prefWidth="90" text="Capacité"/>
                    <TableColumn fx:id="colStatut" prefWidth="90" text="Statut"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Button fx:id="btnNouvelle" text="Nouvelle salle" styleClass="btn-primary" onAction="#handleNouvelle"/>
                <Button fx:id="btnModifier" text="Modifier" styleClass="btn-secondary" onAction="#handleModifier"/>
                <Button fx:id="btnArchiver" text="Archiver / Restaurer" styleClass="btn-archive" onAction="#handleArchiver"/>
            </HBox>
        </VBox>
        <VBox spacing="12" styleClass="card" prefWidth="320" minWidth="320">
            <Label text="Fiche salle" styleClass="section-title"/>
            <VBox spacing="4">
                <Label text="Nom" styleClass="field-label"/>
                <TextField fx:id="txtNom" promptText=""/>
            </VBox>
            <VBox spacing="4">
                <Label text="Capacité (places)" styleClass="field-label"/>
                <TextField fx:id="txtCapacite" promptText=""/>
            </VBox>
            <Label fx:id="lblErreur" text="" styleClass="error-label"/>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Button fx:id="btnEnregistrer" text="Enregistrer" styleClass="btn-primary" onAction="#handleEnregistrer"/>
                <Button fx:id="btnAnnuler" text="Annuler" styleClass="btn-outline" onAction="#handleAnnuler"/>
            </HBox>
        </VBox>
    </HBox>
    <VBox spacing="12" styleClass="card" prefHeight="280">
        <Label text="Grille tarifaire" styleClass="section-title"/>
        <HBox spacing="16" VBox.vgrow="ALWAYS">
            <TableView fx:id="tblTarifs" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colCategorie" prefWidth="200" text="Catégorie"/>
                    <TableColumn fx:id="colPrix" prefWidth="100" text="Prix (Rs)"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
            <VBox spacing="12" styleClass="card" prefWidth="260" minWidth="260">
                <VBox spacing="4">
                    <Label text="Nouveau prix (Rs)" styleClass="field-label"/>
                    <TextField fx:id="txtPrix" promptText=""/>
                </VBox>
                <Button fx:id="btnModifierTarif" text="Modifier le tarif" styleClass="btn-secondary" onAction="#handleModifierTarif"/>
            </VBox>
        </HBox>
    </VBox>
</VBox>
