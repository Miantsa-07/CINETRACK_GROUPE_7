<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" styleClass="page" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cinetrack.controller.TarifController">
    <padding>
        <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
    </padding>
    <children>
        <Label styleClass="page-title" text="Gestion des tarifs" />
        <HBox spacing="20.0" VBox.vgrow="ALWAYS">
            <children>
                <TableView fx:id="tblTarifs" HBox.hgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colLibelle" prefWidth="250.0" text="Libellé" />
                        <TableColumn fx:id="colPrix" prefWidth="120.0" text="Prix (€)" />
                        <TableColumn fx:id="colDescription" prefWidth="300.0" text="Description" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
                <VBox prefWidth="300.0" spacing="10.0" styleClass="form-panel">
                    <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                    </padding>
                    <children>
                        <Label styleClass="form-title" text="Fiche tarif" textAlignment="CENTER" />
                        <Label text="Libellé" />
                        <TextField fx:id="txtLibelle" />
                        <Label text="Prix (€)" />
                        <TextField fx:id="txtPrix" />
                        <Label text="Description" />
                        <TextArea fx:id="txtDescription" prefRowCount="4" wrapText="true" />
                        <Label fx:id="lblMessage" styleClass="error-label" wrapText="true" />
                        <HBox spacing="8.0">
                            <children>
                                <Button fx:id="btnAjouter" onAction="#onAjouter" prefHeight="25.0" prefWidth="89.0" styleClass="btn-add" text="Ajouter" />
                                <Button fx:id="btnModifier" onAction="#onModifier" prefHeight="25.0" prefWidth="90.0" styleClass="btn-edit" text="Modifier" />
                                <Button fx:id="btnSupprimer" onAction="#onSupprimer" prefHeight="25.0" prefWidth="90.0" styleClass="btn-delete" text="Supprimer" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>