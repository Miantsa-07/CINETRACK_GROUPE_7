<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" styleClass="login-root" prefHeight="640" prefWidth="960" fx:controller="cinetrack.controller.LoginController">
    <stylesheets>
        <URL value="@/css/style.css"/>
    </stylesheets>
    <VBox alignment="CENTER_LEFT" maxWidth="380" maxHeight="-Infinity" spacing="12" styleClass="card">
        <Label text="CineTrack" styleClass="title"/>
        <Label text="Cinéma Le Lumière · Accès réservé au personnel" styleClass="muted" wrapText="true"/>
        <VBox spacing="4">
            <Label text="Identifiant" styleClass="field-label"/>
            <TextField fx:id="txtIdentifiant"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Mot de passe" styleClass="field-label"/>
            <PasswordField fx:id="txtMotDePasse" onAction="#handleConnexion"/>
        </VBox>
        <Label fx:id="lblErreur" styleClass="error-label" wrapText="true"/>
        <Button fx:id="btnConnexion" text="Se connecter" defaultButton="true" maxWidth="Infinity" styleClass="btn-primary, btn-large" onAction="#handleConnexion"/>
    </VBox>
</StackPane>
