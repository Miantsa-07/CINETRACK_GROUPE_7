<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" spacing="16" styleClass="page" fx:controller="com.cinetrack.controller.InventaireController">
    <padding>
        <Insets top="28" right="36" bottom="28" left="36"/>
    </padding>
    <stylesheets>
        <URL value="@../css/cinetrack.css"/>
    </stylesheets>
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox>
            <Label text="Inventaire du parc logiciel" styleClass="title"/>
            <Label fx:id="lblNbLogiciels" text="0 logiciel" styleClass="muted"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>
    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <VBox spacing="12" styleClass="card" HBox.hgrow="ALWAYS">
            <HBox spacing="10" alignment="BOTTOM_LEFT">
                <VBox spacing="4">
                    <Label text="Catégorie" styleClass="field-label"/>
                    <ComboBox fx:id="cmbFiltreCategorie" promptText="Toutes" maxWidth="Infinity" onAction="#handleFiltrer"/>
                </VBox>
                <VBox spacing="4">
                    <Label text="Statut" styleClass="field-label"/>
                    <ComboBox fx:id="cmbFiltreStatut" promptText="Tous" maxWidth="Infinity" onAction="#handleFiltrer"/>
                </VBox>
                <CheckBox fx:id="chkArchives" text="Afficher les archivés" onAction="#handleFiltrer"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnExportCsv" text="Exporter en CSV" styleClass="btn-secondary" onAction="#handleExportCsv"/>
                <Button fx:id="btnExportPdf" text="Exporter en PDF" styleClass="btn-secondary" onAction="#handleExportPdf"/>
            </HBox>
            <TableView fx:id="tblLogiciels" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colNom" prefWidth="150" text="Logiciel"/>
                    <TableColumn fx:id="colEditeur" prefWidth="120" text="Éditeur"/>
                    <TableColumn fx:id="colVersion" prefWidth="80" text="Version"/>
                    <TableColumn fx:id="colCategorie" prefWidth="110" text="Catégorie"/>
                    <TableColumn fx:id="colInstallation" prefWidth="100" text="Installé le"/>
                    <TableColumn fx:id="colStatut" prefWidth="90" text="Statut"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
            <Label text="Historique des mises à jour" styleClass="section-title"/>
            <TableView fx:id="tblHistorique" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colHDate" prefWidth="100" text="Date"/>
                    <TableColumn fx:id="colHVersion" prefWidth="90" text="Version"/>
                    <TableColumn fx:id="colHNote" prefWidth="240" text="Note"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Button fx:id="btnArchiver" text="Archiver / Restaurer" styleClass="btn-archive" onAction="#handleArchiver"/>
            </HBox>
        </VBox>
        <VBox spacing="12" styleClass="card" prefWidth="320" minWidth="320">
            <Label text="Fiche logiciel" styleClass="section-title"/>
            <VBox spacing="4">
                <Label text="Nom" styleClass="field-label"/>
                <TextField fx:id="txtNom" promptText=""/>
            </VBox>
            <VBox spacing="4">
                <Label text="Éditeur" styleClass="field-label"/>
                <TextField fx:id="txtEditeur" promptText=""/>
            </VBox>
            <VBox spacing="4">
                <Label text="Version" styleClass="field-label"/>
                <TextField fx:id="txtVersion" promptText=""/>
            </VBox>
            <VBox spacing="4">
                <Label text="Catégorie" styleClass="field-label"/>
                <ComboBox fx:id="cmbCategorie" promptText="Système, développement, bureautique, sécurité, autre" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Date d’installation" styleClass="field-label"/>
                <DatePicker fx:id="dpInstallation" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Statut" styleClass="field-label"/>
                <ComboBox fx:id="cmbStatut" promptText="À jour, obsolète, à désinstaller" maxWidth="Infinity"/>
            </VBox>
            <Label fx:id="lblErreur" text="" styleClass="error-label"/>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Button fx:id="btnEnregistrer" text="Enregistrer" styleClass="btn-primary" onAction="#handleEnregistrer"/>
                <Button fx:id="btnAnnuler" text="Annuler" styleClass="btn-outline" onAction="#handleAnnuler"/>
            </HBox>
        </VBox>
    </HBox>
</VBox>
