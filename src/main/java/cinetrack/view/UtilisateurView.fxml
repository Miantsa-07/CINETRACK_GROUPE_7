<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" spacing="16" styleClass="page" fx:controller="com.cinetrack.controller.UtilisateurController">
    <padding>
        <Insets top="28" right="36" bottom="28" left="36"/>
    </padding>
    <stylesheets>
        <URL value="@../css/cinetrack.css"/>
    </stylesheets>
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox>
            <Label text="Utilisateurs et accès" styleClass="title"/>
            <Label fx:id="lblNbUsers" text="0 compte" styleClass="muted"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>
    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <VBox spacing="12" styleClass="card" HBox.hgrow="ALWAYS">
            <TableView fx:id="tblUtilisateurs" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colIdentifiant" prefWidth="130" text="Identifiant"/>
                    <TableColumn fx:id="colRole" prefWidth="120" text="Rôle"/>
                    <TableColumn fx:id="colStatut" prefWidth="90" text="Statut"/>
                    <TableColumn fx:id="colConnexion" prefWidth="150" text="Dernière connexion"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Button fx:id="btnDebloquer" text="Débloquer" styleClass="btn-secondary" onAction="#handleDebloquer"/>
                <Button fx:id="btnDesactiver" text="Désactiver / Réactiver" styleClass="btn-archive" onAction="#handleDesactiver"/>
            </HBox>
        </VBox>
        <VBox spacing="12" styleClass="card" prefWidth="320" minWidth="320">
            <Label text="Compte utilisateur" styleClass="section-title"/>
            <VBox spacing="4">
                <Label text="Identifiant" styleClass="field-label"/>
                <TextField fx:id="txtIdentifiant" promptText=""/>
            </VBox>
            <VBox spacing="4">
                <Label text="Mot de passe" styleClass="field-label"/>
                <PasswordField fx:id="txtMotDePasse"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Rôle" styleClass="field-label"/>
                <ComboBox fx:id="cmbRole" promptText="Administrateur ou caissier" maxWidth="Infinity"/>
            </VBox>
            <Label text="Le mot de passe est haché (BCrypt) avant enregistrement." styleClass="muted" wrapText="true"/>
            <Label fx:id="lblErreur" text="" styleClass="error-label"/>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Button fx:id="btnEnregistrer" text="Enregistrer" styleClass="btn-primary" onAction="#handleEnregistrer"/>
                <Button fx:id="btnAnnuler" text="Annuler" styleClass="btn-outline" onAction="#handleAnnuler"/>
            </HBox>
        </VBox>
    </HBox>
</VBox>
