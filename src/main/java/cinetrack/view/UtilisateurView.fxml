<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" styleClass="page" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cinetrack.controller.UtilisateurController">
    <padding>
        <Insets bottom="28" left="36" right="36" top="28" />
    </padding>
    <stylesheets>
        <URL value="@/css/style.css" />
    </stylesheets>
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox>
            <Label styleClass="title" text="Utilisateurs et accès" />
            <Label fx:id="lblNbUsers" styleClass="muted" text="0 compte" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
    </HBox>
    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <VBox spacing="12" styleClass="card" HBox.hgrow="ALWAYS">
            <TableView fx:id="tblUtilisateurs" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colIdentifiant" prefWidth="130" text="Identifiant" />
                    <TableColumn fx:id="colRole" prefWidth="120" text="Rôle" />
                    <TableColumn fx:id="colStatut" prefWidth="90" text="Statut" />
                    <TableColumn fx:id="colConnexion" prefWidth="150" text="Dernière connexion" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Button fx:id="btnDesactiver" onAction="#handleDesactiver" styleClass="btn-archive" text="Désactiver / Réactiver" />
            </HBox>
        </VBox>
        <VBox minWidth="320" prefWidth="320" spacing="12" styleClass="card">
            <Label styleClass="section-title" text="Compte utilisateur" />
            <VBox spacing="4">
                <Label styleClass="field-label" text="Identifiant" />
                <TextField fx:id="txtIdentifiant" promptText="" />
            </VBox>
            <VBox spacing="4">
                <Label styleClass="field-label" text="Mot de passe" />
                <PasswordField fx:id="txtMotDePasse" />
            </VBox>
            <VBox spacing="4">
                <Label styleClass="field-label" text="Rôle" />
                <ComboBox fx:id="cmbRole" maxWidth="Infinity" promptText="Administrateur ou caissier" />
            </VBox>
            <Label fx:id="lblErreur" styleClass="error-label" text="" />
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Button fx:id="btnEnregistrer" onAction="#handleEnregistrer" styleClass="btn-primary" text="Enregistrer" />
                <Button fx:id="btnAnnuler" onAction="#handleAnnuler" styleClass="btn-outline" text="Annuler" />
            </HBox>
        </VBox>
    </HBox>
</VBox>
