<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" styleClass="page" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cinetrack.controller.StatsController">
    <padding>
        <Insets bottom="28" left="36" right="36" top="28" />
    </padding>
    <stylesheets>
        <URL value="@/css/style.css" />
    </stylesheets>
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox>
            <Label styleClass="title" text="Tableau de bord" />
            <Label fx:id="lblPeriode" styleClass="muted" text="Statistiques d’exploitation" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
    </HBox>
    <HBox alignment="BOTTOM_LEFT" spacing="10">
        <VBox spacing="4">
            <Label styleClass="field-label" text="Période" />
            <ComboBox fx:id="cmbPeriode" maxWidth="Infinity" onAction="#handlePeriode" promptText="Période" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnExportPdf" onAction="#handleExportPdf" styleClass="btn-secondary" text="Exporter en PDF" />
    </HBox>
    <HBox spacing="16">
        <VBox maxWidth="Infinity" spacing="12" styleClass="card" HBox.hgrow="ALWAYS">
            <Label styleClass="muted" text="Chiffre d’affaires" />
            <Label fx:id="lblCA" styleClass="kpi-value" text="0 Rs" />
        </VBox>
        <VBox maxWidth="Infinity" spacing="12" styleClass="card" HBox.hgrow="ALWAYS">
            <Label styleClass="muted" text="Billets vendus" />
            <Label fx:id="lblBillets" styleClass="kpi-value" text="0" />
        </VBox>
        <VBox maxWidth="Infinity" spacing="12" styleClass="card" HBox.hgrow="ALWAYS">
            <Label styleClass="muted" text="Taux d’occupation" />
            <Label fx:id="lblTaux" styleClass="kpi-value" text="0 %" />
        </VBox>
        <VBox maxWidth="Infinity" spacing="12" styleClass="card" HBox.hgrow="ALWAYS">
            <Label styleClass="muted" text="Séances programmées" />
            <Label fx:id="lblSeances" styleClass="kpi-value" text="0" />
        </VBox>
    </HBox>
    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <VBox spacing="12" styleClass="card" HBox.hgrow="ALWAYS">
            <Label styleClass="section-title" text="Films les plus réservés" />
            <BarChart fx:id="chartFilms" legendVisible="false" VBox.vgrow="ALWAYS">
                <xAxis>
                    <CategoryAxis />
                </xAxis>
                <yAxis>
                    <NumberAxis />
                </yAxis>
            </BarChart>
        </VBox>
        <VBox prefWidth="360" spacing="12" styleClass="card">
            <Label styleClass="section-title" text="Occupation par salle" />
            <TableView fx:id="tblOccupationSalles" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colSalle" prefWidth="120" text="Salle" />
                    <TableColumn fx:id="colTauxSalle" prefWidth="80" text="Taux" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </HBox>
    <VBox prefHeight="220" spacing="12" styleClass="card">
        <Label styleClass="section-title" text="Occupation par séance" />
        <TableView fx:id="tblOccupationSeances" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colSeance" prefWidth="140" text="Séance" />
                <TableColumn fx:id="colFilmStat" prefWidth="180" text="Film" />
                <TableColumn fx:id="colSalleStat" prefWidth="90" text="Salle" />
                <TableColumn fx:id="colVendus" prefWidth="80" text="Vendus" />
                <TableColumn fx:id="colTauxSeance" prefWidth="80" text="Taux" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </VBox>
</VBox>
