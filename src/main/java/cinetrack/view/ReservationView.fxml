<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" styleClass="page" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cinetrack.controller.ReservationController">
    <padding>
        <Insets bottom="28" left="36" right="36" top="28" />
    </padding>
    <stylesheets>
        <URL value="@/css/style.css" />
    </stylesheets>
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox>
            <Label styleClass="title" text="Reservations" />
            <Label fx:id="lblNbBillets" styleClass="muted" text="0 billet" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
    </HBox>
    <VBox spacing="12" styleClass="card" VBox.vgrow="ALWAYS">
        <HBox alignment="BOTTOM_LEFT" spacing="10">
            <VBox spacing="4">
                <Label styleClass="field-label" text="Recherche" />
                <TextField fx:id="txtRecherche" onKeyReleased="#handleFiltrer" prefHeight="38.0" prefWidth="176.0" promptText="N° de billet ou nom du client" />
            </VBox>
            <VBox spacing="4">
                <Label styleClass="field-label" text="Statut" />
                <ComboBox fx:id="cmbStatut" maxWidth="Infinity" onAction="#handleFiltrer" promptText="Tous" />
            </VBox>
            <VBox spacing="4">
                <Label styleClass="field-label" text="Date" />
                <DatePicker fx:id="dpDate" maxWidth="Infinity" onAction="#handleFiltrer" />
            </VBox>
        </HBox>
        <TableView fx:id="tblBillets" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colBillet" prefWidth="90" text="Billet" />
                <TableColumn fx:id="colClient" prefWidth="150" text="Client" />
                <TableColumn fx:id="colFilm" prefWidth="160" text="Film" />
                <TableColumn fx:id="colSeance" prefWidth="130" text="Séance" />
                <TableColumn fx:id="colSiege" prefWidth="60" text="Siège" />
                <TableColumn fx:id="colCategorie" prefWidth="110" text="Catégorie" />
                <TableColumn fx:id="colMontant" prefWidth="90" text="Montant" />
                <TableColumn fx:id="colStatut" prefWidth="80" text="Statut" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Button fx:id="btnAnnulerBillet" onAction="#handleAnnulerBillet" styleClass="btn-danger" text="Annuler le billet" />
            <Button fx:id="btnReimprimer" onAction="#handleReimprimer" styleClass="btn-secondary" text="Réimprimer" />
        </HBox>
    </VBox>
</VBox>
