<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" styleClass="page" prefHeight="760" prefWidth="1280" fx:controller="cinetrack.controller.MainController">
    <stylesheets>
        <URL value="@/css/style.css"/>
    </stylesheets>
    <left>
        <VBox spacing="24" styleClass="sidebar" prefWidth="232" minWidth="232">
            <Label text="CineTrack" styleClass="logo"/>
            <VBox spacing="4" VBox.vgrow="ALWAYS">
                <Button fx:id="btnStats" text="Tableau de bord" maxWidth="Infinity" styleClass="nav-button" onAction="#showStats"/>
                <Button fx:id="btnFilms" text="Films" maxWidth="Infinity" styleClass="nav-button" onAction="#showFilms"/>
                <Button fx:id="btnPlanning" text="Programmation" maxWidth="Infinity" styleClass="nav-button" onAction="#showPlanning"/>
                <Button fx:id="btnBillet" text="Billetterie" maxWidth="Infinity" styleClass="nav-button" onAction="#showBillet"/>
                <Button fx:id="btnReservations" text="Billets émis" maxWidth="Infinity" styleClass="nav-button" onAction="#showReservations"/>
                <Button fx:id="btnClients" text="Clients" maxWidth="Infinity" styleClass="nav-button" onAction="#showClients"/>
                <Button fx:id="btnSalles" text="Salles et tarifs" maxWidth="Infinity" styleClass="nav-button" onAction="#showSalles"/>
                <Button fx:id="btnAvis" text="Avis" maxWidth="Infinity" styleClass="nav-button" onAction="#showAvis"/>
                <Button fx:id="btnInventaire" text="Inventaire logiciel" maxWidth="Infinity" styleClass="nav-button" onAction="#showInventaire"/>
                <Button fx:id="btnUtilisateurs" text="Utilisateurs" maxWidth="Infinity" styleClass="nav-button" onAction="#showUtilisateurs"/>
                <Button fx:id="btnLogs" text="Journal" maxWidth="Infinity" styleClass="nav-button" onAction="#showLogs"/>
            </VBox>
            <VBox spacing="4" styleClass="user-box">
                <Label fx:id="lblUtilisateur" text="Utilisateur" styleClass="user-name"/>
                <Label fx:id="lblRole" text="Rôle" styleClass="user-role"/>
                <Button fx:id="btnDeconnexion" text="Se déconnecter" maxWidth="Infinity" styleClass="btn-outline-light" onAction="#handleDeconnexion"/>
            </VBox>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contentPane"/>
    </center>
</BorderPane>
