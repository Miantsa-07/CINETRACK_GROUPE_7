<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" styleClass="page" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cinetrack.controller.AvisController">
    <padding>
        <Insets bottom="28" left="36" right="36" top="28" />
    </padding>
    <stylesheets>
        <URL value="@/css/style.css" />
    </stylesheets>
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox>
            <Label styleClass="title" text="Avis et notes" />
            <Label fx:id="lblMoyenne" styleClass="muted" text="Note moyenne : —" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
    </HBox>
    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <VBox spacing="12" styleClass="card" HBox.hgrow="ALWAYS">
            <HBox alignment="BOTTOM_LEFT" spacing="10">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label styleClass="field-label" text="Film" />
                    <ComboBox fx:id="cmbFilm" maxWidth="Infinity" onAction="#handleFilm" promptText="Choisir un film" />
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label styleClass="field-label" text="Recherche" />
                    <TextField fx:id="txtRecherche" maxWidth="Infinity" onKeyReleased="#handleFiltrer" prefHeight="41.0" prefWidth="176.0" promptText="Mot du commentaire" />
                </VBox>
                <VBox spacing="4">
                    <Label styleClass="field-label" text="Note" />
                    <ComboBox fx:id="cmbNoteFiltre" onAction="#handleFiltrer" prefHeight="41.0" prefWidth="150" promptText="Toutes les notes" />
                </VBox>
                <Button fx:id="btnReinitialiser" onAction="#handleReinitialiserFiltres" prefHeight="43.0" prefWidth="103.0" styleClass="btn-secondary" text="Réinitialiser" />
            </HBox>
            <TableView fx:id="tblAvis" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colNote" prefWidth="100" text="Note" />
                    <TableColumn fx:id="colCommentaire" prefWidth="300" text="Commentaire" />
                    <TableColumn fx:id="colDate" prefWidth="100" text="Date" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
            <Label fx:id="lblNbAvis" styleClass="muted" text="0 avis" />
         <HBox fx:id="boxEtoiles1" alignment="CENTER_LEFT" spacing="4">
            <children>
               <Label fx:id="etoile11" onMouseClicked="#handleEtoile" styleClass="etoile" text="☆" />
               <Label fx:id="etoile21" onMouseClicked="#handleEtoile" styleClass="etoile" text="☆" />
               <Label fx:id="etoile31" onMouseClicked="#handleEtoile" styleClass="etoile" text="☆" />
               <Label fx:id="etoile41" onMouseClicked="#handleEtoile" styleClass="etoile" text="☆" />
               <Label fx:id="etoile51" onMouseClicked="#handleEtoile" styleClass="etoile" text="☆" />
            </children>
         </HBox>
        </VBox>
        <VBox minWidth="320" prefWidth="320" spacing="12" styleClass="card">
            <Label styleClass="section-title" text="Laisser un avis" />
            <VBox spacing="4">
                <Label styleClass="field-label" text="Note" />
                <HBox fx:id="boxEtoiles" alignment="CENTER_LEFT" spacing="4">
                    <Label fx:id="etoile1" onMouseClicked="#handleEtoile" styleClass="etoile" text="☆" />
                    <Label fx:id="etoile2" onMouseClicked="#handleEtoile" styleClass="etoile" text="☆" />
                    <Label fx:id="etoile3" onMouseClicked="#handleEtoile" styleClass="etoile" text="☆" />
                    <Label fx:id="etoile4" onMouseClicked="#handleEtoile" styleClass="etoile" text="☆" />
                    <Label fx:id="etoile5" onMouseClicked="#handleEtoile" styleClass="etoile" text="☆" />
                </HBox>
                <Label fx:id="lblNoteChoisie" styleClass="muted" text="Aucune note" />
            </VBox>
            <VBox spacing="4">
                <Label styleClass="field-label" text="Commentaire" />
                <TextArea fx:id="txtCommentaire" prefRowCount="3" wrapText="true" />
            </VBox>
            <Label fx:id="lblErreur" styleClass="error-label" text="" />
            <Button fx:id="btnAjouterAvis" onAction="#handleAjouterAvis" styleClass="btn-primary" text="Ajouter l’avis" />
        </VBox>
    </HBox>
   <HBox fx:id="boxEtoiles2" alignment="CENTER_LEFT" spacing="4">
      <children>
         <Label fx:id="etoile12" onMouseClicked="#handleEtoile" styleClass="etoile" text="☆" />
         <Label fx:id="etoile22" onMouseClicked="#handleEtoile" styleClass="etoile" text="☆" />
         <Label fx:id="etoile32" onMouseClicked="#handleEtoile" styleClass="etoile" text="☆" />
         <Label fx:id="etoile42" onMouseClicked="#handleEtoile" styleClass="etoile" text="☆" />
         <Label fx:id="etoile52" onMouseClicked="#handleEtoile" styleClass="etoile" text="☆" />
      </children>
   </HBox>
</VBox>
