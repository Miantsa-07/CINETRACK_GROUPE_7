<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" spacing="16" styleClass="page" fx:controller="cinetrack.controller.FilmController">
    <padding>
        <Insets top="28" right="36" bottom="28" left="36"/>
    </padding>
    <stylesheets>
        <URL value="@/css/style.css"/>
    </stylesheets>
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox>
            <Label text="Catalogue de films" styleClass="title"/>
            <Label fx:id="lblNbFilms" text="0 film" styleClass="muted"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnNouveau" text="Ajouter un film" styleClass="btn-primary" onAction="#handleNouveau"/>
    </HBox>
    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <VBox spacing="12" styleClass="card" HBox.hgrow="ALWAYS">
            <HBox spacing="10" alignment="BOTTOM_LEFT">
                <VBox spacing="4">
                    <Label text="Recherche" styleClass="field-label"/>
                    <TextField fx:id="txtRecherche" promptText="Titre ou genre" onKeyReleased="#handleFiltrer"/>
                </VBox>
                <VBox spacing="4">
                    <Label text="Genre" styleClass="field-label"/>
                    <ComboBox fx:id="cmbGenre" promptText="Tous" maxWidth="Infinity" onAction="#handleFiltrer"/>
                </VBox>
                <CheckBox fx:id="chkArchives" text="Afficher les archivés" onAction="#handleFiltrer"/>
            </HBox>
            <TableView fx:id="tblFilms" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colTitre" prefWidth="200" text="Titre"/>
                    <TableColumn fx:id="colGenre" prefWidth="110" text="Genre"/>
                    <TableColumn fx:id="colDuree" prefWidth="70" text="Durée"/>
                    <TableColumn fx:id="colNote" prefWidth="110" text="Note moyenne"/>
                    <TableColumn fx:id="colStatut" prefWidth="90" text="Statut"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Button fx:id="btnModifier" text="Modifier" styleClass="btn-secondary" onAction="#handleModifier"/>
                <Button fx:id="btnAvis" text="Avis" styleClass="btn-secondary" onAction="#handleAvis"/>
                <Button fx:id="btnArchiver" text="Archiver / Restaurer" styleClass="btn-archive" onAction="#handleArchiver"/>
            </HBox>
        </VBox>
        <VBox spacing="12" styleClass="card" prefWidth="320" minWidth="320">
            <Label text="Fiche film" styleClass="section-title"/>
            <VBox spacing="4">
                <Label text="Titre" styleClass="field-label"/>
                <TextField fx:id="txtTitre" promptText=""/>
            </VBox>
            <VBox spacing="4">
                <Label text="Durée (minutes)" styleClass="field-label"/>
                <TextField fx:id="txtDuree" promptText=""/>
            </VBox>
            <VBox spacing="4">
                <Label text="Genre" styleClass="field-label"/>
                <TextField fx:id="txtGenre" promptText=""/>
            </VBox>
            <VBox spacing="4">
                <Label text="Synopsis" styleClass="field-label"/>
                <TextArea fx:id="txtSynopsis" prefRowCount="3" wrapText="true"/>
            </VBox>
            <Label fx:id="lblErreur" text="" styleClass="error-label"/>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Button fx:id="btnEnregistrer" text="Enregistrer" styleClass="btn-primary" onAction="#handleEnregistrer"/>
                <Button fx:id="btnAnnuler" text="Annuler" styleClass="btn-outline" onAction="#handleAnnuler"/>
            </HBox>
        </VBox>
    </HBox>
</VBox>
