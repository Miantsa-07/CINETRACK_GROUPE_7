<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" styleClass="page" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cinetrack.controller.FilmController">
    <padding>
        <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
    </padding>
    <children>
        <Label styleClass="page-title" text="Catalogue des films" />
        <HBox spacing="10.0">
            <children>
                <TextField fx:id="txtRecherche" onKeyReleased="#onRechercher" prefHeight="25.0" prefWidth="237.0" promptText="Rechercher par titre" />
                <ComboBox fx:id="cbGenreFiltre" onAction="#onRechercher" prefHeight="25.0" prefWidth="120.0" promptText="Genre" />
            </children>
        </HBox>
        <HBox spacing="20.0" VBox.vgrow="ALWAYS">
            <children>
                <TableView fx:id="tblFilms" HBox.hgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colTitre" prefWidth="240.0" text="Titre" />
                        <TableColumn fx:id="colGenre" prefWidth="130.0" text="Genre" />
                        <TableColumn fx:id="colDuree" prefWidth="100.0" text="Durée (min)" />
                        <TableColumn fx:id="colNote" prefWidth="90.0" text="Note" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
                <VBox prefWidth="300.0" spacing="10.0" styleClass="form-panel">
                    <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                    </padding>
                    <children>
                        <Label styleClass="form-title" text="Fiche film" textAlignment="CENTER" />
                        <Label text="Titre" />
                        <TextField fx:id="txtTitre" />
                        <ComboBox fx:id="cbGenre" maxWidth="1.7976931348623157E308" promptText="Genre" />
                        <Label text="Durée (minutes)" />
                        <TextField fx:id="txtDuree" />
                        <Label text="Synopsis" />
                        <TextArea fx:id="txtSynopsis" prefRowCount="5" wrapText="true" />
                        <Label fx:id="lblMessage" styleClass="error-label" wrapText="true" />
                        <HBox spacing="8.0">
                            <children>
                                <Button fx:id="btnAjouter" onAction="#onAjouter" prefHeight="25.0" prefWidth="89.0" styleClass="btn-add" text="Ajouter" />
                                <Button fx:id="btnModifier" onAction="#onModifier" prefHeight="25.0" prefWidth="90.0" styleClass="btn-edit" text="Modifier" />
                                <Button fx:id="btnSupprimer" onAction="#onSupprimer" prefHeight="25.0" prefWidth="90.0" styleClass="btn-delete" text="Supprimer" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>
