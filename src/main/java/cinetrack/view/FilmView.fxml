<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" styleClass="page" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cinetrack.controller.FilmController">
    <padding>
        <Insets bottom="28" left="36" right="36" top="28" />
    </padding>
    <stylesheets>
        <URL value="@/css/style.css" />
    </stylesheets>
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox>
            <Label styleClass="title" text="Catalogue de films" />
            <Label fx:id="lblNbFilms" styleClass="muted" text="0 film" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnNouveau" onAction="#handleNouveau" styleClass="btn-primary" text="Ajouter un film" />
    </HBox>
    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <VBox spacing="12" styleClass="card" HBox.hgrow="ALWAYS">
            <HBox alignment="BOTTOM_LEFT" spacing="10">
                <VBox spacing="4">
                    <Label styleClass="field-label" text="Recherche" />
                    <TextField fx:id="txtRecherche" onKeyReleased="#handleFiltrer" prefHeight="39.0" prefWidth="176.0" promptText="Titre ou genre" />
                </VBox>
                <VBox prefHeight="47.0" prefWidth="99.0" spacing="4">
                    <Label styleClass="field-label" text="Genre" />
                    <ComboBox fx:id="cmbGenre" maxWidth="Infinity" onAction="#handleFiltrer" prefHeight="27.0" prefWidth="99.0" promptText="Tous" />
                </VBox>
            </HBox>
            <TableView fx:id="tblFilms" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colCouverture" maxWidth="64" minWidth="64" prefWidth="64" sortable="false" text="" />
                    <TableColumn fx:id="colTitre" prefWidth="200" text="Titre" />
                    <TableColumn fx:id="colGenre" prefWidth="110" text="Genre" />
                    <TableColumn fx:id="colDuree" prefWidth="70" text="Durée" />
                    <TableColumn fx:id="colNote" prefWidth="110" text="Note moyenne" />
                    <TableColumn fx:id="colStatut" prefWidth="90" text="Statut" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Button fx:id="btnModifier" onAction="#handleModifier" styleClass="btn-secondary" text="Modifier" />
                <Button fx:id="btnAvis" onAction="#handleAvis" styleClass="btn-secondary" text="Avis" />
                <Button fx:id="btnArchiver" onAction="#handleArchiver" styleClass="btn-archive" text="Archiver / Restaurer" />
            </HBox>
        </VBox>
        <VBox minWidth="320" prefWidth="320" spacing="12" styleClass="card">
            <Label styleClass="section-title" text="Fiche film" />
            <HBox alignment="TOP_LEFT" spacing="14">
                <StackPane minHeight="168" minWidth="112" prefHeight="168" prefWidth="112" styleClass="cover-box">
                    <ImageView fx:id="imgCouverture" fitHeight="168" fitWidth="112" pickOnBounds="true" preserveRatio="true" />
                    <Label fx:id="lblAucuneImage" styleClass="muted" text="Aucune image" />
                </StackPane>
                <VBox spacing="8">
                    <Label styleClass="field-label" text="Image de couverture" />
                    <Button fx:id="btnChoisirImage" onAction="#handleChoisirImage" styleClass="btn-secondary" text="Choisir une image..." />
                    <Button fx:id="btnRetirerImage" onAction="#handleRetirerImage" styleClass="btn-outline" text="Retirer l'image" />
                    <Label maxWidth="150" styleClass="muted" text="JPG ou PNG, 5 Mo maximum." wrapText="true" />
                </VBox>
            </HBox>
            <VBox spacing="4">
                <Label styleClass="field-label" text="Titre" />
                <TextField fx:id="txtTitre" promptText="" />
            </VBox>
            <VBox spacing="4">
                <Label styleClass="field-label" text="Durée " />
                <TextField fx:id="txtDuree" promptText="" />
            </VBox>
            <VBox spacing="4">
                <Label styleClass="field-label" text="Genre" />
                <TextField fx:id="txtGenre" promptText="" />
            </VBox>
            <VBox spacing="4">
                <Label styleClass="field-label" text="Synopsis" />
                <TextArea fx:id="txtSynopsis" prefRowCount="3" wrapText="true" />
            </VBox>
            <Label fx:id="lblErreur" styleClass="error-label" text="" />
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Button fx:id="btnEnregistrer" onAction="#handleEnregistrer" styleClass="btn-primary" text="Enregistrer" />
                <Button fx:id="btnAnnuler" onAction="#handleAnnuler" styleClass="btn-outline" text="Annuler" />
            </HBox>
        </VBox>
    </HBox>
</VBox>
