<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" styleClass="page" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cinetrack.controller.ClientController">
    <padding>
        <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
    </padding>
    <children>
        <Label styleClass="page-title" text="Gestion des clients" />
        <HBox spacing="10.0">
            <children>
                <TextField fx:id="txtRecherche" onKeyReleased="#onRechercher" prefHeight="25.0" prefWidth="237.0" promptText="Rechercher par nom" />
            </children>
        </HBox>
        <HBox spacing="20.0" VBox.vgrow="ALWAYS">
            <children>
                <TableView fx:id="tblClients" HBox.hgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colNom" prefWidth="200.0" text="Nom" />
                        <TableColumn fx:id="colPrenom" prefWidth="200.0" text="Prénom" />
                        <TableColumn fx:id="colEmail" prefWidth="250.0" text="Email" />
                        <TableColumn fx:id="colTelephone" prefWidth="150.0" text="Téléphone" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
                <VBox prefWidth="300.0" spacing="10.0" styleClass="form-panel">
                    <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                    </padding>
                    <children>
                        <Label styleClass="form-title" text="Fiche client" textAlignment="CENTER" />
                        <Label text="Nom" />
                        <TextField fx:id="txtNom" />
                        <Label text="Prénom" />
                        <TextField fx:id="txtPrenom" />
                        <Label text="Email" />
                        <TextField fx:id="txtEmail" />
                        <Label text="Téléphone" />
                        <TextField fx:id="txtTelephone" />
                        <Label fx:id="lblMessage" styleClass="error-label" wrapText="true" />
                        <HBox spacing="8.0">
                            <children>
                                <Button fx:id="btnAjouter" onAction="#onAjouter" prefHeight="25.0" prefWidth="89.0" styleClass="btn-add" text="Ajouter" />
                                <Button fx:id="btnModifier" onAction="#onModifier" prefHeight="25.0" prefWidth="90.0" styleClass="btn-edit" text="Modifier" />
                                <Button fx:id="btnSupprimer" onAction="#onSupprimer" prefHeight="25.0" prefWidth="90.0" styleClass="btn-delete" text="Supprimer" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>