<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" spacing="16" styleClass="page" fx:controller="cinetrack.controller.ClientController">
    <padding>
        <Insets top="28" right="36" bottom="28" left="36"/>
    </padding>
    <stylesheets>
        <URL value="@/css/style.css"/>
    </stylesheets>
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox>
            <Label text="Clients" styleClass="title"/>
            <Label fx:id="lblNbClients" text="0 fiche" styleClass="muted"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>
    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <VBox spacing="12" styleClass="card" HBox.hgrow="ALWAYS">
            <VBox spacing="4">
                <Label text="Recherche" styleClass="field-label"/>
                <TextField fx:id="txtRecherche" promptText="Nom, prénom ou téléphone" onKeyReleased="#handleFiltrer"/>
            </VBox>
            <TableView fx:id="tblClients" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colNom" prefWidth="150" text="Nom"/>
                    <TableColumn fx:id="colPrenom" prefWidth="150" text="Prénom"/>
                    <TableColumn fx:id="colTelephone" prefWidth="120" text="Téléphone"/>
                    <TableColumn fx:id="colBillets" prefWidth="70" text="Billets"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Button fx:id="btnNouveau" text="Nouveau client" styleClass="btn-primary" onAction="#handleNouveau"/>
                <Button fx:id="btnModifier" text="Modifier" styleClass="btn-secondary" onAction="#handleModifier"/>
            </HBox>
        </VBox>
        <VBox spacing="12" styleClass="card" prefWidth="320" minWidth="320">
            <Label text="Fiche client" styleClass="section-title"/>
            <VBox spacing="4">
                <Label text="Nom" styleClass="field-label"/>
                <TextField fx:id="txtNom" promptText=""/>
            </VBox>
            <VBox spacing="4">
                <Label text="Prénom" styleClass="field-label"/>
                <TextField fx:id="txtPrenom" promptText=""/>
            </VBox>
            <VBox spacing="4">
                <Label text="Téléphone" styleClass="field-label"/>
                <TextField fx:id="txtTelephone" promptText=""/>
            </VBox>
            <Label fx:id="lblErreur" text="" styleClass="error-label"/>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Button fx:id="btnEnregistrer" text="Enregistrer" styleClass="btn-primary" onAction="#handleEnregistrer"/>
                <Button fx:id="btnAnnuler" text="Annuler" styleClass="btn-outline" onAction="#handleAnnuler"/>
            </HBox>
        </VBox>
    </HBox>
</VBox>
