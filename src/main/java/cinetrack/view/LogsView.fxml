<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" styleClass="page" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cinetrack.controller.LogsController">
    <padding>
        <Insets bottom="28" left="36" right="36" top="28" />
    </padding>
    <stylesheets>
        <URL value="@/css/style.css" />
    </stylesheets>
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox>
            <Label styleClass="title" text="Journal des actions" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
    </HBox>
    <VBox spacing="12" styleClass="card" VBox.vgrow="ALWAYS">
        <HBox alignment="BOTTOM_LEFT" spacing="10">
            <VBox spacing="4">
                <Label styleClass="field-label" text="Recherche" />
                <TextField fx:id="txtRecherche" onKeyReleased="#handleFiltrer" promptText="Utilisateur ou donnée" />
            </VBox>
            <VBox spacing="4">
                <Label styleClass="field-label" text="Action" />
                <ComboBox fx:id="cmbAction" maxWidth="Infinity" onAction="#handleFiltrer" promptText="Toutes" />
            </VBox>
            <VBox spacing="4">
                <Label styleClass="field-label" text="Date" />
                <DatePicker fx:id="dpDate" maxWidth="Infinity" onAction="#handleFiltrer" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnExport" onAction="#handleExport" styleClass="btn-secondary" text="Exporter" />
        </HBox>
        <TableView fx:id="tblLogs" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colDate" prefWidth="150" text="Date et heure" />
                <TableColumn fx:id="colUtilisateur" prefWidth="110" text="Utilisateur" />
                <TableColumn fx:id="colAction" prefWidth="200" text="Action" />
                <TableColumn fx:id="colDonnees" prefWidth="250" text="Données concernées" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </VBox>
</VBox>
