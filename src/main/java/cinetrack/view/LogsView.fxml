<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" spacing="16" styleClass="page" fx:controller="cinetrack.controller.LogsController">
    <padding>
        <Insets top="28" right="36" bottom="28" left="36"/>
    </padding>
    <stylesheets>
        <URL value="@/css/style.css"/>
    </stylesheets>
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox>
            <Label text="Journal des actions" styleClass="title"/>
            <Label fx:id="lblNbLogs" text="0 entrée" styleClass="muted"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>
    <VBox spacing="12" styleClass="card" VBox.vgrow="ALWAYS">
        <HBox spacing="10" alignment="BOTTOM_LEFT">
            <VBox spacing="4">
                <Label text="Recherche" styleClass="field-label"/>
                <TextField fx:id="txtRecherche" promptText="Utilisateur ou donnée" onKeyReleased="#handleFiltrer"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Action" styleClass="field-label"/>
                <ComboBox fx:id="cmbAction" promptText="Toutes" maxWidth="Infinity" onAction="#handleFiltrer"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Date" styleClass="field-label"/>
                <DatePicker fx:id="dpDate" maxWidth="Infinity" onAction="#handleFiltrer"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnExport" text="Exporter" styleClass="btn-secondary" onAction="#handleExport"/>
        </HBox>
        <TableView fx:id="tblLogs" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colDate" prefWidth="150" text="Date et heure"/>
                <TableColumn fx:id="colUtilisateur" prefWidth="110" text="Utilisateur"/>
                <TableColumn fx:id="colAction" prefWidth="200" text="Action"/>
                <TableColumn fx:id="colDonnees" prefWidth="250" text="Données concernées"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </VBox>
</VBox>
