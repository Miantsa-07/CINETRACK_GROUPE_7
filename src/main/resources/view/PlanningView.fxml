<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" styleClass="page" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cinetrack.controller.PlanningController">
    <padding>
        <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
    </padding>
    <children>
        <Label styleClass="page-title" text="Planning des séances" />
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <DatePicker fx:id="dpFiltreDate" onAction="#onFiltrer" prefHeight="25.0" prefWidth="195.0" promptText="Date" />
                <ComboBox fx:id="cbFiltreSalle" onAction="#onFiltrer" prefHeight="25.0" prefWidth="151.0" promptText="Toutes les salles" />
                <ComboBox fx:id="cbFiltreFilm" onAction="#onFiltrer" prefHeight="25.0" prefWidth="146.0" promptText="Tous les films" />
                <Button fx:id="btnReinitFiltres" onAction="#onReinitFiltres" styleClass="btn-secondary" text="Réinitialiser les filtres" />
            </children>
        </HBox>
        <HBox spacing="20.0" VBox.vgrow="ALWAYS">
            <children>
                <TableView fx:id="tblSeances" HBox.hgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colFilm" prefWidth="200.0" text="Film" />
                        <TableColumn fx:id="colSalle" prefWidth="100.0" text="Salle" />
                        <TableColumn fx:id="colDate" prefWidth="100.0" text="Date" />
                        <TableColumn fx:id="colDebut" prefWidth="70.0" text="Début" />
                        <TableColumn fx:id="colFin" prefWidth="70.0" text="Fin" />
                        <TableColumn fx:id="colPlaces" prefWidth="110.0" text="Places restantes" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
                <VBox prefWidth="300.0" spacing="10.0" styleClass="form-panel">
                    <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                    </padding>
                    <children>
                        <Label styleClass="form-title" text="Fiche séance" />
                        <ComboBox fx:id="cbFilm" maxWidth="1.7976931348623157E308" promptText="Film" />
                        <ComboBox fx:id="cbSalle" maxWidth="1.7976931348623157E308" promptText="Salle" />
                        <Label text="Date" />
                        <DatePicker fx:id="dpDate" maxWidth="1.7976931348623157E308" />
                        <Label text="Heure de début" />
                        <TextField fx:id="txtHeureDebut" promptText="HH:mm (ex : 18:30)" />
                        <Label fx:id="lblHeureFin" styleClass="info-label" text="Fin prévue : --:--" />
                        <Label fx:id="lblMessage" styleClass="error-label" wrapText="true" />
                        <HBox spacing="8.0">
                            <children>
                                <Button fx:id="btnAjouter" onAction="#onAjouter" prefHeight="25.0" prefWidth="89.0" styleClass="btn-add" text="Ajouter" />
                                <Button fx:id="btnModifier" onAction="#onModifier" prefHeight="25.0" prefWidth="90.0" styleClass="btn-edit" text="Modifier" />
                                <Button fx:id="btnSupprimer" onAction="#onSupprimer" prefHeight="25.0" prefWidth="89.0" styleClass="btn-delete" text="Supprimer" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>
